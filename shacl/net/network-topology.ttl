@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix ex: <https://example.com/rig#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# SHACL Shape for Network Topology
# Validates that network devices have proper linkage for cyber triage and diagnostics

ex:NetworkDeviceShape
    a sh:NodeShape ;
    rdfs:label "Network Device Shape"@en ;
    rdfs:comment "Validates that a network device has required properties for topology mapping and cyber diagnostics"@en ;
    sh:targetClass ex:NetworkDevice ;
    sh:property [
        sh:path ex:hasIPAddress ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:pattern "^([0-9]{1,3}\\.){3}[0-9]{1,3}$" ;
        sh:message "Network device must have a valid IP address"@en ;
    ] ;
    sh:property [
        sh:path ex:belongsToVLAN ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Network device must belong to a VLAN"@en ;
    ] ;
    sh:property [
        sh:path ex:connectedToSwitch ;
        sh:nodeKind sh:IRI ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:message "Network device may be connected to a switch"@en ;
    ] ;
    sh:property [
        sh:path ex:hasSwitchPort ;
        sh:datatype xsd:string ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:message "Network device may have a switch port"@en ;
    ] ;
    sh:property [
        sh:path rdfs:label ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Network device must have a human-readable label"@en ;
    ] .

# Shape for VLAN
ex:VLANShape
    a sh:NodeShape ;
    rdfs:label "VLAN Shape"@en ;
    rdfs:comment "Validates that a VLAN has required properties"@en ;
    sh:targetClass ex:VLAN ;
    sh:property [
        sh:path ex:vlanId ;
        sh:datatype xsd:unsignedInt ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "VLAN must have a VLAN ID"@en ;
    ] ;
    sh:property [
        sh:path rdfs:label ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "VLAN must have a human-readable label"@en ;
    ] .

