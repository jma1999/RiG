# IFC-LD Instance Builder - native IFC to RDF conversion
# https://github.com/devonsparks/ifcld-service
FROM python:3.11-slim

WORKDIR /app

# Clone ifcld-service
RUN apt-get update && apt-get install -y git && rm -rf /var/lib/apt/lists/*
RUN git clone https://github.com/devonsparks/ifcld-service.git .

RUN pip install --no-cache-dir -r requirements.txt

EXPOSE 5000

CMD ["python3", "service.py"]
