ifc:ifcasset a sh:NodeShape ;
    sh:and ( ifc:ifcgroup ) ;
    sh:name "ifcasset"@en ;
    sh:property [ sh:order 5 ;
            sh:path ifc:assetid ],
        [ sh:order 6 ;
            sh:path ifc:originalvalue ],
        [ sh:order 7 ;
            sh:path ifc:currentvalue ],
        [ sh:order 8 ;
            sh:path ifc:totalreplacementcost ],
        [ sh:order 9 ;
            sh:path ifc:owner ],
        [ sh:order 10 ;
            sh:path ifc:user ],
        [ sh:order 11 ;
            sh:path ifc:responsibleperson ],
        [ sh:order 12 ;
            sh:path ifc:incorporationdate ],
        [ sh:order 13 ;
            sh:path ifc:depreciatedvalue ],
        ifc:assetid,
        ifc:currentvalue,
        ifc:depreciatedvalue,
        ifc:incorporationdate,
        ifc:originalvalue,
        ifc:owner,
        ifc:responsibleperson,
        ifc:totalreplacementcost,
        ifc:user ;
    sh:targetClass ifc:ifcasset .

