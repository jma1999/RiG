@prefix dash: <http://datashapes.org/dash#> .
@prefix ifc: <http://ifc-ld.org/schemas/ifc2x3#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ifc:ifcvectorordirection a sh:NodeShape ;
    sh:xone ( ifc:ifcdirection ifc:ifcvector ) .

ifc:ifc2dcompositecurve a sh:NodeShape ;
    sh:and ( ifc:ifccompositecurve ) ;
    sh:name "ifc2dcompositecurve"@en ;
    sh:targetClass ifc:ifc2dcompositecurve .

ifc:ifcactionrequest a sh:NodeShape ;
    sh:and ( ifc:ifccontrol ) ;
    sh:name "ifcactionrequest"@en ;
    sh:property [ sh:order 5 ;
            sh:path ifc:requestid ],
        ifc:requestid ;
    sh:targetClass ifc:ifcactionrequest .

