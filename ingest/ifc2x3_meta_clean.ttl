        ifc:arithmeticoperator,
        ifc:componentoftotal,
        ifc:components,
        ifc:description,
        ifc:name ;
    sh:targetClass ifc:ifcappliedvaluerelationship .

ifc:ifcappliedvalueselect a sh:NodeShape ;
    sh:xone ( ifc:ifcratiomeasure ifc:ifcmeasurewithunit ifc:ifcmonetarymeasure ) .

